### J) Spieler 1 trifft (1,1) und versenkt damit den Zerstoerer
# @no-cookie-jar
# @name shotJ
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}
Content-Type: text/plain;charset=UTF-8

4210["game:shoot",{"x":1,"y":1}]

### J) Versenkt-Meldung
# @no-cookie-jar
# @name pollShotJ
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}

> {%
    const body = String(response.body);
    client.test("Zweiter Treffer versenkt den Zerstoerer", function () {
        client.assert(body.indexOf("\"result\":\"hit\"") !== -1, "Kein Treffer: " + body);
        client.assert(body.indexOf("\"sunk\":2") !== -1, "Nicht versenkt gemeldet: " + body);
    });
    client.test("Das Spiel laeuft weiter - es stehen noch Schiffe", function () {
        client.assert(body.indexOf("\"phase\":\"IN_PROGRESS\"") !== -1, "Phase falsch: " + body);
        client.assert(body.indexOf("\"winner\":null") !== -1, "winner gesetzt: " + body);
    });
%}

### Spielstand von Spieler 1 nach den Schuessen (ueber REST gegengeprueft)
# @no-cookie-jar
# @name stateAfterShots
GET {{host}}/games/{{gameId}}/state
Cookie: SESSION_ID={{player1Session}}

> {%
    client.test("Alle Schuesse von Spieler 1 sind protokolliert", function () {
        // A (9,0), F (5,5), H (1,0), J (1,1) - die abgelehnten Schuesse nicht.
        client.assert(
            response.body.yourShots.length === 4,
            "yourShots: " + JSON.stringify(response.body.yourShots)
        );
    });
    client.test("Die Schuesse des Gegners sind sichtbar", function () {
        // C (0,0), G (0,2), I (1,2)
        client.assert(
            response.body.opponentShots.length === 3,
            "opponentShots: " + JSON.stringify(response.body.opponentShots)
        );
    });
    client.test("Treffer sind auf der eigenen Flotte vermerkt", function () {
        const carrier = response.body.yourShips.find(function (ship) { return ship.size === 5; });
        client.assert(carrier.hits === 1, "Traeger-Treffer: " + carrier.hits);
    });
    client.test("Die Gegnerflotte bleibt verborgen", function () {
        client.assert(response.body.opponentShips === null, "Gegnerflotte wurde ausgeliefert!");
    });
%}

### Spielstand ueber den Socket anfordern (game:state als Request)
# @no-cookie-jar
# @name requestStateOverSocket
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}
Content-Type: text/plain;charset=UTF-8

4211["game:state"]

### Antwort auf die Spielstand-Anfrage
# @no-cookie-jar
# @name pollRequestedState
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}

> {%
    const body = String(response.body);
    client.test("Der Socket liefert denselben Spielstand", function () {
        client.assert(body.indexOf("4311[") !== -1, "Kein ACK mit Id 11: " + body);
        client.assert(body.indexOf("\"yourRole\":\"first\"") !== -1, "yourRole fehlt: " + body);
    });
%}

### Optional: Pong nachschicken, falls der Server ein Ping (2) geliefert hat
# Haelt die Polling-Verbindung am Leben, wenn man die Requests einzeln durchklickt.
# @no-cookie-jar
# @name pong
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}
Content-Type: text/plain;charset=UTF-8

3
