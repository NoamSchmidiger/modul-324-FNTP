### Koordinaten keine ganzen Zahlen -> 400
# @no-cookie-jar
# @name nonIntegerCoordinates
POST {{host}}/games/{{validationGameId}}/ships
Content-Type: application/json
Cookie: SESSION_ID={{player3Session}}

{
  "ships": [
    { "x": 0.5, "y": 0, "size": 5, "orientation": "horizontal" },
    { "x": 0, "y": 2, "size": 4, "orientation": "horizontal" },
    { "x": 0, "y": 4, "size": 3, "orientation": "horizontal" },
    { "x": 0, "y": 6, "size": 3, "orientation": "horizontal" },
    { "x": 0, "y": 8, "size": 2, "orientation": "horizontal" }
  ]
}

> {%
    client.test("Kommazahlen werden abgelehnt", function () {
        client.assert(response.status === 400, "Status war " + response.status);
        client.assert(
            response.body.error === "x, y und size müssen ganze Zahlen sein",
            "Meldung war: " + response.body.error
        );
    });
%}

### Leerer Body -> 400
# @no-cookie-jar
# @name emptyBody
POST {{host}}/games/{{validationGameId}}/ships
Content-Type: application/json
Cookie: SESSION_ID={{player3Session}}

{}

> {%
    client.test("Fehlende Schiffsliste wird abgelehnt", function () {
        client.assert(response.status === 400, "Status war " + response.status);
        client.assert(
            response.body.error === "Es müssen genau 5 Schiffe platziert werden",
            "Meldung war: " + response.body.error
        );
    });
%}

### Nach all den Fehlversuchen ist noch nichts platziert
# @no-cookie-jar
# @name validationGameState
GET {{host}}/games/{{validationGameId}}/state
Cookie: SESSION_ID={{player3Session}}

> {%
    client.test("Ungueltige Flotten wurden nicht gespeichert", function () {
        client.assert(response.body.youArePlaced === false, "youArePlaced war true");
        client.assert(response.body.yourShips === null, "yourShips: " + JSON.stringify(response.body.yourShips));
    });
    client.test("Spiel wartet weiterhin auf einen Gegner", function () {
        client.assert(
            response.body.phase === "WAITING_FOR_PLAYER",
            "Phase war " + response.body.phase
        );
    });
%}
