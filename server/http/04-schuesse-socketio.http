### F) Wasser wird als miss gemeldet, Zug wechselt trotzdem
# @no-cookie-jar
# @name pollShotF
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}

> {%
    const body = String(response.body);
