### C) Spieler 2 holt das Ergebnis ab
# @no-cookie-jar
# @name pollShotC
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer2}}

> {%
    const body = String(response.body);
    client.test("Treffer von Spieler 2", function () {
        client.assert(body.indexOf("\"by\":\"second\"") !== -1, "Falscher Schuetze: " + body);
        client.assert(body.indexOf("\"result\":\"hit\"") !== -1, "Kein Treffer: " + body);
    });
    client.test("Der Zug wandert zurueck zu Spieler 1", function () {
        client.assert(body.indexOf("\"turn\":\"first\"") !== -1, "turn falsch: " + body);
    });
%}

