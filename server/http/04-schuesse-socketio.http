###    THIS WAS PARTIALLY GENERATED WITH THE HELP OF AI    ###

# Schuesse und Zugwechsel ueber Socket.IO.
#
# Der HTTP-Client kann kein Socket.IO sprechen, aber Socket.IO laeuft auch ueber
# HTTP-Polling (Engine.IO). Genau das nutzt diese Datei: jeder Request ist ein
# Engine.IO-Paket.
#
# Paketformat (Engine.IO 4 + Socket.IO 5):
#   0{...}                        OPEN, Antwort auf den Handshake, enthaelt die sid
#   40{...}                       CONNECT, der JSON-Teil ist socket.handshake.auth
#   42["event",{...}]             EVENT ohne Acknowledgement
#   42<id>["event",{...}]         EVENT mit Acknowledgement-Id
#   43<id>[{...}]                 ACK (die Antwort des Servers auf dieses Event)
#   2 / 3                         Ping (Server) / Pong (Client)
#
# WICHTIG:
#   - Vorher 01-happy-path.http ausfuehren, damit gameId, player1Session und
#     player2Session gesetzt sind und die Partie in der Phase IN_PROGRESS ist.
#   - Diese Datei am besten komplett ausfuehren (Run all requests in file).
#     Klickt man die Requests einzeln und langsam durch, wirft Engine.IO die
#     Verbindung nach ca. 45 Sekunden weg (Ping/Pong). Der letzte Request in
#     dieser Datei zeigt, wie man ein Pong nachschickt.
#   - Ein GET-Poll ohne wartende Nachrichten haengt bis zu 25 Sekunden (Long
#     Polling). Darum wird nur gepollt, wenn auch etwas abzuholen ist.
#
# Flotte von Spieler 2 (Ziel von Spieler 1), alle senkrecht ab y=0:
#   x=9 Traeger (5)  x=7 Schlachtschiff (4)  x=5 Kreuzer (3)
#   x=3 U-Boot (3)   x=1 Zerstoerer (2) -> (1,0) und (1,1)
# Flotte von Spieler 1 (Ziel von Spieler 2), alle waagrecht ab x=0:
#   y=0 Traeger (5)  y=2 Schlachtschiff (4)  y=4 Kreuzer (3)
#   y=6 U-Boot (3)   y=8 Zerstoerer (2)

### Handshake Spieler 1 - das Session-Cookie muss hier mitkommen
# @no-cookie-jar
# @name handshakePlayer1
GET {{host}}/socket.io/?EIO=4&transport=polling
Cookie: SESSION_ID={{player1Session}}

> {%
    const body = String(response.body);
    client.test("Handshake liefert ein OPEN-Paket", function () {
        client.assert(response.status === 200, "Status war " + response.status);
        client.assert(body.charAt(0) === "0", "Kein OPEN-Paket: " + body);
    });
    client.global.set("sidPlayer1", body.match(/"sid":"([^"]+)"/)[1]);
%}

### Spieler 1 verbindet sich mit der Partie (hier laeuft io.use() durch)
# @no-cookie-jar
# @name connectPlayer1
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}
Content-Type: text/plain;charset=UTF-8

40{"gameSessionId":"{{gameId}}"}

> {%
    client.test("Paket wird angenommen", function () {
        client.assert(response.status === 200, "Status war " + response.status);
    });
%}

### Spieler 1 holt CONNECT-Bestaetigung und den gepushten Spielstand ab
# @no-cookie-jar
# @name pollPlayer1AfterConnect
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}

> {%
    const body = String(response.body);
    client.test("Verbindung wurde akzeptiert", function () {
        client.assert(
            body.indexOf("44") === -1,
            "Verbindung abgelehnt (CONNECT_ERROR): " + body
        );
        client.assert(body.indexOf("40") !== -1, "Keine CONNECT-Bestaetigung: " + body);
    });
    client.test("Der Server pusht den Spielstand", function () {
        client.assert(body.indexOf("game:state") !== -1, "Kein game:state: " + body);
        client.assert(body.indexOf("\"yourRole\":\"first\"") !== -1, "yourRole fehlt: " + body);
        client.assert(body.indexOf("\"yourTurn\":true") !== -1, "Spieler 1 ist nicht am Zug: " + body);
    });
    client.test("Die Gegnerflotte wird nicht gepusht", function () {
        client.assert(body.indexOf("\"opponentShips\":null") !== -1, "opponentShips: " + body);
    });
%}

### Handshake Spieler 2
# @no-cookie-jar
# @name handshakePlayer2
GET {{host}}/socket.io/?EIO=4&transport=polling
Cookie: SESSION_ID={{player2Session}}

> {%
    const body = String(response.body);
    client.test("Handshake liefert ein OPEN-Paket", function () {
        client.assert(body.charAt(0) === "0", "Kein OPEN-Paket: " + body);
    });
    client.global.set("sidPlayer2", body.match(/"sid":"([^"]+)"/)[1]);
%}

### Spieler 2 verbindet sich mit der Partie
# @no-cookie-jar
# @name connectPlayer2
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer2}}
Content-Type: text/plain;charset=UTF-8

40{"gameSessionId":"{{gameId}}"}

### Spieler 2 holt seinen Spielstand ab
# @no-cookie-jar
# @name pollPlayer2AfterConnect
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer2}}

> {%
    const body = String(response.body);
    client.test("Verbindung wurde akzeptiert", function () {
        client.assert(body.indexOf("44") === -1, "Verbindung abgelehnt: " + body);
    });
    client.test("Spieler 2 ist 'second' und nicht am Zug", function () {
        client.assert(body.indexOf("\"yourRole\":\"second\"") !== -1, "yourRole fehlt: " + body);
        client.assert(body.indexOf("\"yourTurn\":false") !== -1, "yourTurn war true: " + body);
    });
%}

### Verbindung ohne gueltige Session wird abgelehnt (fremdes Cookie)
# @no-cookie-jar
# @name handshakeStranger
GET {{host}}/socket.io/?EIO=4&transport=polling
Cookie: SESSION_ID=ich-bin-kein-spieler

> {%
    client.global.set("sidStranger", String(response.body).match(/"sid":"([^"]+)"/)[1]);
%}

### Der Fremde versucht, sich mit der Partie zu verbinden
# @no-cookie-jar
# @name connectStranger
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidStranger}}
Content-Type: text/plain;charset=UTF-8

40{"gameSessionId":"{{gameId}}"}

### ... und bekommt einen CONNECT_ERROR
# @no-cookie-jar
# @name pollStranger
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidStranger}}

> {%
    const body = String(response.body);
    client.test("Fremde Session wird abgewiesen", function () {
        client.assert(body.indexOf("44") !== -1, "Kein CONNECT_ERROR: " + body);
        client.assert(
            body.indexOf("Sie sind kein Spieler dieser Partie") !== -1,
            "Andere Meldung: " + body
        );
    });
%}

### A) Spieler 1 schiesst auf (9,0) - Traeger von Spieler 2 -> Treffer
# @no-cookie-jar
# @name shotA
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}
Content-Type: text/plain;charset=UTF-8

421["game:shoot",{"x":9,"y":0}]

### A) Spieler 1 holt Acknowledgement und Broadcast ab
# @no-cookie-jar
# @name pollShotA
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}

> {%
    const body = String(response.body);
    client.test("Acknowledgement zum Schuss kommt zurueck", function () {
        client.assert(body.indexOf("431[") !== -1, "Kein ACK mit Id 1: " + body);
    });
    client.test("Treffer wird gemeldet", function () {
        client.assert(body.indexOf("\"result\":\"hit\"") !== -1, "Kein Treffer: " + body);
        client.assert(body.indexOf("\"by\":\"first\"") !== -1, "Falscher Schuetze: " + body);
    });
    client.test("Treffer versenkt den Traeger noch nicht", function () {
        client.assert(body.indexOf("\"sunk\":null") !== -1, "sunk war gesetzt: " + body);
    });
    client.test("Jetzt ist Spieler 2 am Zug", function () {
        client.assert(body.indexOf("\"turn\":\"second\"") !== -1, "turn falsch: " + body);
    });
    client.test("Noch kein Sieger", function () {
        client.assert(body.indexOf("\"winner\":null") !== -1, "winner gesetzt: " + body);
    });
%}

### A) Spieler 2 sieht denselben Schuss
# @no-cookie-jar
# @name pollShotAPlayer2
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer2}}

> {%
    const body = String(response.body);
    client.test("Der Gegner wird ueber den Schuss informiert", function () {
        client.assert(body.indexOf("game:shot") !== -1, "Kein game:shot: " + body);
        client.assert(body.indexOf("\"x\":9") !== -1, "Koordinate fehlt: " + body);
        client.assert(body.indexOf("\"result\":\"hit\"") !== -1, "Ergebnis fehlt: " + body);
    });
    client.test("Spieler 2 erfaehrt, dass er am Zug ist", function () {
        client.assert(body.indexOf("\"turn\":\"second\"") !== -1, "turn falsch: " + body);
    });
%}

### B) Spieler 1 schiesst nochmal, obwohl Spieler 2 am Zug ist
# @no-cookie-jar
# @name shotB
POST {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}
Content-Type: text/plain;charset=UTF-8

422["game:shoot",{"x":9,"y":1}]

### B) Der Schuss wird abgelehnt
# @no-cookie-jar
# @name pollShotB
GET {{host}}/socket.io/?EIO=4&transport=polling&sid={{sidPlayer1}}

> {%
    const body = String(response.body);
    client.test("Nur wer am Zug ist, darf schiessen", function () {
        client.assert(body.indexOf("Sie sind nicht am Zug") !== -1, "Andere Antwort: " + body);
    });
    client.test("Fehler kommt als ACK und als game:error", function () {
        client.assert(body.indexOf("432[") !== -1, "Kein ACK mit Id 2: " + body);
        client.assert(body.indexOf("game:error") !== -1, "Kein game:error: " + body);
    });
%}

